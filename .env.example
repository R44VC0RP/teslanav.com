# Existing TeslaNav services
NEXT_PUBLIC_MAPBOX_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
BLOB_READ_WRITE_TOKEN=
LOCATIONIQ_API_KEY=
INBOUND_API_KEY=
ADMIN_API_KEY=
NEXT_PUBLIC_PROJECT_SHUTDOWN=false

# TeslaNav account and device sessions (at least 32 random characters)
TESLANAV_SESSION_SECRET=
NEXT_PUBLIC_APP_URL=https://app.teslanav.com

# Tesla Fleet API partner application
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://app.teslanav.com/api/auth/tesla/callback
TESLA_FLEET_API_BASE_URL=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_FLEET_REGION=na
TESLA_PARTNER_DOMAIN=teslanav.com
TESLA_PUBLIC_KEY_PEM=

# Tesla vehicle-command proxy and Fleet Telemetry receiver
TESLA_COMMAND_PROXY_URL=https://tesla-command-proxy.internal
TESLA_TELEMETRY_HOSTNAME=telemetry.teslanav.com
TESLA_TELEMETRY_CA=
TESLA_TELEMETRY_INGEST_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Local development only; never enable in production
TESLANAV_BILLING_BYPASS=false
